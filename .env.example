# Credential Manager entry name. Useful when switching between tenants/accounts.
TEAMS_CREDENTIAL_PROFILE=default

# Override only when your organization supplies an approved public-client app.
# TEAMS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Chat-service region fallback. The auth response normally discovers this.
TEAMS_REGION=apac

# Writes are rejected unless all three controls pass:
#   1. enabled here, 2. exact target allowlisted, 3. confirm=true on the MCP call.
TEAMS_WRITES_ENABLED=false
# TEAMS_WRITE_ALLOWLIST=chat:19:example@thread.v2,channel:team-id/channel-id
TEAMS_AGENT_MARKER=[MCP]

# Read-state changes are separate from message sending. Reading never marks content read.
# These also require: 1. enabled, 2. exact target allowlisted, 3. confirm=true,
# and exactly one explicit boundary on the MCP call.
TEAMS_READ_STATE_WRITES_ENABLED=false
# TEAMS_READ_STATE_ALLOWLIST=chat:19:example@thread.v2,channel:team-id/channel-id

TEAMS_REQUEST_TIMEOUT_SECONDS=30
TEAMS_MAX_RESPONSE_BYTES=10000000
TEAMS_LOG_LEVEL=INFO
